#!/bin/sh
# Start script of the AppImage.
HERE="$(dirname "$(readlink -f "$0")")"

# The GUI loads libxkbcommon-x11 at run time. Nearly every desktop has it;
# only where it is missing the copy in the AppImage is used.
have_lib() {
    for d in /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib /lib/x86_64-linux-gnu /lib64; do
        [ -e "$d/$1" ] && return 0
    done
    return 1
}
if ! have_lib libxkbcommon-x11.so.0 || ! have_lib libxcb-xkb.so.1; then
    export LD_LIBRARY_PATH="$HERE/usr/lib/fallback${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

exec "$HERE/usr/bin/text-to-audiobook" "$@"
