# Startmenü-Eintrag für Linux. Vorher Exec (Programm) und Path (Projektordner
# mit settings.json, input/, output/) anpassen; siehe FORK_DE.md.
[Desktop Entry]
Type=Application
Name=text-to-audiobook
GenericName=Hörbuch-Erzeugung
Comment=Markdown-Texte in Hörbücher verwandeln
Exec=/pfad/zu/text-to-audiobook
Path=/pfad/zum/projektordner
Icon=text-to-audiobook
Terminal=false
Categories=AudioVideo;Audio;
StartupWMClass=text-to-audiobook
